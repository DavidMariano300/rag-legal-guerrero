# Copiar como .env y ajustar antes de levantar el stack. .env NO se versiona (ver .gitignore).

POSTGRES_USER=raguser
POSTGRES_PASSWORD=changeme
POSTGRES_DB=ragdb

# Modelo de Ollama a usar (debe descargarse con `docker compose exec ollama ollama pull <modelo>`)
OLLAMA_MODEL=qwen3.5:4b
# Embeddings (ver docs/refactorizacion_rag.md §10). Cambiar las cuatro juntas.
EMBEDDING_MODEL=BAAI/bge-m3
QDRANT_COLLECTION=legal_corpus_bge_m3
QDRANT_SESSION_COLLECTION=session_documents_bge_m3
TOP_K_VECTOR=5
# Modelos con "pensamiento" (Qwen3.5, Gemma 4): false lo apaga. Vacío: no se envía la opción.
OLLAMA_THINK=false

# Clave para firmar los JWT de sesión. OBLIGATORIO definir un valor propio y secreto
# antes de producción (si se deja vacío, el backend genera uno aleatorio en cada
# arranque y todas las sesiones se invalidan al reiniciar). Generar con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# Permite consultar sin cuenta ("Consultar como invitado"). Útil para la demo con abogados;
# en producción con usuarios reales conviene ponerlo en false.
PERMITIR_INVITADOS=true
