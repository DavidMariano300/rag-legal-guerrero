meta {
  name: Registro
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/auth/register
  body: json
  auth: none
}

body:json {
  {
    "email": "tu_correo@example.com",
    "password": "tu_contraseña"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("token", res.body.access_token);
  }
}
